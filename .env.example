# OpenSec Intelligence — environment configuration template.
# Copy to .env (gitignored) or export these directly in your shell.
# Never commit a real .env file or a real API key.

# --- Nebius Token Factory (NVIDIA Nemotron) ---------------------------------
# Required for --provider nebius / OPENSEC_AI_PROVIDER=nebius.
NEBIUS_API_KEY=

# Optional — defaults to the public Token Factory endpoint.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Optional — exact model ID (e.g. nvidia/nemotron-super-49b-v1). When unset,
# OpenSec auto-selects a Nemotron model from your account's live catalog
# (GET /v1/models) at startup.
NEBIUS_MODEL=

# Select Nebius for scan/fix/prove without passing --provider every time.
# Values: ollama (default) | nebius
OPENSEC_AI_PROVIDER=ollama

# --- Ollama (local, default) ------------------------------------------------
OPENSEC_OLLAMA_URL=http://localhost:11434
OPENSEC_MODEL=qwen2.5-coder:14b

# --- Optional cloud providers for the general agent layer (opensec serve) --
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
